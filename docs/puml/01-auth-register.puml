@startuml Auth (POST register)

title "Auth (POST register)"

skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundcorner 0
skinparam ArrowColor #334155
skinparam ParticipantBackgroundColor #FDE68A
skinparam ParticipantBorderColor #334155
skinparam DatabaseBackgroundColor #FDE68A
skinparam DatabaseBorderColor #334155
skinparam SequenceLifeLineBorderColor #94A3B8
skinparam SequenceGroupBorderColor #64748B
skinparam SequenceGroupHeaderFontStyle bold
skinparam SequenceGroupBackgroundColor #E2E8F0
skinparam LegendBackgroundColor #FFFBEA
skinparam LegendBorderColor #94A3B8

participant "Client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as routerAuth
participant "<<controllers>>\n:auth" as controllersAuth
participant "<<model>>\n:User" as modelUser
database "<<MongoDB>>\n:users" as UsersDatabase

client->server ++:req.post('/api/v1/auth/register')
server->routerAuth ++:app.use('/api/v1/auth',auth)
routerAuth -> controllersAuth ++:register()
controllersAuth -> modelUser ++:<color:red>create({name, email, tel, password, role})</color>
modelUser -> modelUser :pre('save') bcrypt.hash(password)
modelUser ->UsersDatabase ++: UserSchema
alt success
    UsersDatabase --> modelUser :user
    controllersAuth <-- modelUser :user
    controllersAuth -> modelUser :getSignedJwtToken()
    controllersAuth <-- modelUser :token
    controllersAuth -> client :<color:red>201 {success, _id, name, email, tel, token}</color>
else duplicate email (code 11000)
    UsersDatabase --> modelUser :error
    controllersAuth <-- modelUser :error
    controllersAuth -> client :400 {success: false, message: "Email is already registered"}
else validation error
    UsersDatabase --> modelUser :error
    controllersAuth <-- modelUser :ValidationError
    controllersAuth -> client :400 {success: false, message}
end
deactivate UsersDatabase
deactivate modelUser
deactivate controllersAuth

@enduml
