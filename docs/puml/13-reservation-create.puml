@startuml Manage Reservation (POST)

title "Manage Reservation (POST)"

skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundcorner 0
skinparam ArrowColor #334155
skinparam ParticipantBackgroundColor #FDE68A
skinparam ParticipantBorderColor #334155
skinparam DatabaseBackgroundColor #FDE68A
skinparam DatabaseBorderColor #334155
skinparam SequenceLifeLineBorderColor #94A3B8
skinparam SequenceGroupBorderColor #64748B
skinparam SequenceGroupHeaderFontStyle bold
skinparam SequenceGroupBackgroundColor #E2E8F0
skinparam LegendBackgroundColor #FFFBEA
skinparam LegendBorderColor #94A3B8

participant "Client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:coworkingspaces" as routerCoworkingSpaces
participant "<<router>>\n:reservations" as routerReservations
participant "<<middleware>>\n:auth" as middlewareAuth
participant "<<controllers>>\n:reservations" as controllersReservations
participant "<<model>>\n:CoworkingSpace" as modelCoworkingSpace
database "<<MongoDB>>\n:coworkingspaces" as CoworkingSpacesDatabase
participant "<<model>>\n:Reservation" as modelReservation
database "<<MongoDB>>\n:reservations" as ReservationsDatabase

client->server ++:req.post('/api/v1/coworkingspaces/:coworkingSpaceId/reservations')
server->routerCoworkingSpaces ++:app.use('/api/v1/coworkingspaces',coworkingspaces)
routerCoworkingSpaces->routerReservations ++:router.use('/:coworkingSpaceId/reservations/',reservationRouter)
routerReservations -> middlewareAuth ++:protect, authorize("admin","user")
middlewareAuth -> controllersReservations ++:addReservation()
deactivate middlewareAuth
controllersReservations->modelCoworkingSpace ++:findById(req.params.coworkingSpaceId)
modelCoworkingSpace ->CoworkingSpacesDatabase ++: CoworkingSpaceSchema
CoworkingSpacesDatabase --> modelCoworkingSpace --: coworkingSpace
controllersReservations <-- modelCoworkingSpace --:coworkingSpace
alt coworkingSpace not found
    controllersReservations -> client :404 No coworkingSpace with the id of ...
else reservationDate missing
    controllersReservations -> client :400 Please provide a reservationDate
else
    controllersReservations -> modelReservation ++:countDocuments({user: req.user.id})
    modelReservation ->ReservationsDatabase ++: ReservationSchema
    ReservationsDatabase --> modelReservation --: count
    controllersReservations <-- modelReservation --:count
    alt count >= 3 and role != admin
        controllersReservations -> client :400 The user with ID ... has already made 3 reservations
    else
        controllersReservations -> modelReservation ++:create({reservationDate, coworkingSpace, user})
        modelReservation ->ReservationsDatabase ++: ReservationSchema
        alt invalid date (ValidationError / CastError)
            ReservationsDatabase --> modelReservation :error
            controllersReservations <-- modelReservation :error
            controllersReservations -> client :400 Date string is invalid
        else
            ReservationsDatabase --> modelReservation :reservation
            controllersReservations <-- modelReservation :reservation
            controllersReservations -> client :201 {success, data: reservation}
        end
        deactivate ReservationsDatabase
        deactivate modelReservation
    end
end
deactivate controllersReservations


@enduml
