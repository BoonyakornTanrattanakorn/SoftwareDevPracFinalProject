@startuml Manage Co-working Space (POST)

title "Manage Co-working Space (POST)"

skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundcorner 0
skinparam ArrowColor #334155
skinparam ParticipantBackgroundColor #FDE68A
skinparam ParticipantBorderColor #334155
skinparam DatabaseBackgroundColor #FDE68A
skinparam DatabaseBorderColor #334155
skinparam SequenceLifeLineBorderColor #94A3B8
skinparam SequenceGroupBorderColor #64748B
skinparam SequenceGroupHeaderFontStyle bold
skinparam SequenceGroupBackgroundColor #E2E8F0
skinparam LegendBackgroundColor #FFFBEA
skinparam LegendBorderColor #94A3B8

participant "Client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:coworkingspaces" as routerCoworkingSpaces
participant "<<middleware>>\n:auth" as middlewareAuth
participant "<<controllers>>\n:coworkingspaces" as controllersCoworkingSpaces
participant "<<model>>\n:CoworkingSpace" as modelCoworkingSpace
database "<<MongoDB>>\n:coworkingspaces" as CoworkingSpacesDatabase

client->server ++:req.post('/api/v1/coworkingspaces')
server->routerCoworkingSpaces ++:app.use('/api/v1/coworkingspaces',coworkingspaces)
routerCoworkingSpaces -> middlewareAuth ++:protect, authorize("admin")
middlewareAuth -> controllersCoworkingSpaces ++:createCoworkingSpace()
deactivate middlewareAuth
controllersCoworkingSpaces->modelCoworkingSpace ++:create(req.body)
modelCoworkingSpace ->CoworkingSpacesDatabase ++: CoworkingSpaceSchema
alt success
    CoworkingSpacesDatabase --> modelCoworkingSpace :coworkingSpace
    controllersCoworkingSpaces <-- modelCoworkingSpace :coworkingSpace
    controllersCoworkingSpaces -> client :201 {success, data: coworkingSpace}
else validation error
    CoworkingSpacesDatabase --> modelCoworkingSpace :error
    controllersCoworkingSpaces <-- modelCoworkingSpace :ValidationError
    controllersCoworkingSpaces -> client :400 {success: false, message}
end
deactivate CoworkingSpacesDatabase
deactivate modelCoworkingSpace
deactivate controllersCoworkingSpaces

@enduml
